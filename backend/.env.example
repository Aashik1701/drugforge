# ============================================================================
# DrugForge Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real keys to version control!
# ============================================================================

# Environment
ENVIRONMENT=development
PORT=5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Supabase (Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/drugforge

# Security
  JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ML Models (relative to backend/app/, since the app is run from there — see README)
MODELS_PATH=../models

# LLM Provider (for Context-Aware Chat) — see app/services/llm/
# LLM_PROVIDER selects the implementation; only "gemini" exists today.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# Docking (AutoDock Vina) — see docs/development/local-worker.md
# ============================================================================
# Install the pinned, checksum-verified Vina binary with: scripts/setup_vina.sh
# It lands at backend/bin/vina (gitignored). Override the location if needed:
# VINA_BIN=/absolute/path/to/vina

# Docking is disabled in the default battery-saver compute mode. Set to
# "balanced" or "performance" to allow it (or POST /api/compute/mode at runtime).
COMPUTE_MODE=battery-saver

# --- Determinism -----------------------------------------------------------
# Vina's Monte Carlo search is stochastic. These make a stored affinity
# reproducible from the job record alone; all three are recorded in every
# docking job's output.
DOCKING_SEED=42            # fixed integer — NEVER time/PID-derived
DOCKING_CPU=1              # Vina threads; a fixed count is required for
                          # bit-identical results across machines
DOCKING_N_POSES=5         # --num_modes: how many poses Vina reports
DOCKING_EXHAUSTIVENESS=8  # default when a request doesn't specify one
DOCKING_TIMEOUT_SECONDS=600
