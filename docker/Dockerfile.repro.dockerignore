# Context for docker/Dockerfile.repro. More permissive than the top-level
# .dockerignore: the reproduction test needs ml/datasets/*.csv and runs/*.json.
.git
.DS_Store
**/.DS_Store
frontend
research
ml/training
ml/models
ml/datasets/admet
ml/datasets/extended_admet
**/venv
**/.venv
**/__pycache__
**/*.pyc
**/node_modules
**/.pytest_cache
**/.benchmarks
**/*.db
**/*.db-wal
**/*.db-shm
backend/bin/vina
runs/_*.json
runs/*.svg
