# Environment Variables Required for Deployment
# SECURITY: Do NOT commit .env files with real keys to version control!
# Copy this file to .env.development and .env then add your actual keys.

# Google Gemini API Key for Chatbot
# Get your key from: https://makersuite.google.com/app/apikey
VITE_API_GENERATIVE_LANGUAGE_CLIENT=your_gemini_api_key_here

# OpenAI API Key (backup, not currently used)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Backend Flask API URL
VITE_FLASK_API_URL=http://localhost:5000

# Environment
NODE_ENV=production

# Reduces continuous decorative animation (aurora/meteor/glow/shimmer).
# Does not affect 3D molecule/docking visualization. Defaults to true in
# dev, false in production if unset.
VITE_PERFORMANCE_MODE=false
